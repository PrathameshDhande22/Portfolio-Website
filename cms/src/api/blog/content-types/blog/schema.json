{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "Blogs"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string",
      "required": true
    },
    "Slug": {
      "type": "uid",
      "targetField": "Title",
      "required": true
    },
    "Skill": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::skill.skill"
    },
    "Description": {
      "type": "string"
    },
    "Thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "BlogContent": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::blog-content.blog-content",
      "mappedBy": "Blog"
    }
  }
}
