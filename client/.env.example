BASE_URL=http://localhost:1337/api
API_TOKEN=your_api_token_here

# Public origin of this site, used for canonical URLs, sitemap and OpenGraph
SITE_URL=http://localhost:3000

# Origin serving Strapi media (MinIO in development, S3-compatible in production).
# Must match the host in the media URLs Strapi returns, or next/image will reject them.
MEDIA_URL=http://localhost:9000

# Read-only GitHub personal access token, used for the contribution heatmap
GITHUB_TOKEN=github_pat_replace_me

# Shared secret the Strapi webhook sends to /api/revalidate to flush cached content
REVALIDATE_SECRET=change-me

# Secret to communicate with the Assistant API. 
SECRET=change-me-secret
